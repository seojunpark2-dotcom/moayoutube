# v2: Vercel provides the UI; each visitor runs the Windows local companion.
# Optional HTTPS URL for the public companion ZIP; GitHub Releases is the default.
# COMPANION_DOWNLOAD_URL=https://github.com/seojunpark2-dotcom/moayoutube-local/releases/latest/download/moayoutube-local-windows-x64.zip

# API_ORIGIN and NEXT_PUBLIC_DOWNLOAD_ORIGIN are no longer used by the frontend.
# Custom web domains must also be added to the companion allowed origins.
# WEB_ORIGIN=https://moayoutube.vercel.app
# WEB_ORIGINS=https://your-custom-domain.example
