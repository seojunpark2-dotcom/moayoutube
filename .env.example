# Vercel: set API_ORIGIN to your separately deployed backend HTTPS origin, then rebuild.
# This is a public address, not a secret. No trailing /api or credentials.
API_ORIGIN=https://api.example.com
# Optional separate public file origin; defaults to API_ORIGIN in the frontend build.
# NEXT_PUBLIC_DOWNLOAD_ORIGIN=https://api.example.com
# Backend environment (use hosting settings, not the frontend .env.local):
# API_HOST=0.0.0.0
# API_PORT=4000
# WEB_ORIGIN=https://your-project.vercel.app
