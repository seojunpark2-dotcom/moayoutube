# Vercel: set API_ORIGIN to your separately deployed backend HTTPS origin, then rebuild.
# This is a public address, not a secret. No trailing /api or credentials.
API_ORIGIN=https://api.example.com
# Optional separate public file origin; defaults to API_ORIGIN in the frontend build.
# NEXT_PUBLIC_DOWNLOAD_ORIGIN=https://api.example.com
# Backend environment (use hosting settings, not the frontend .env.local):
# API_HOST=0.0.0.0
# API_PORT=4000
# Hosting provider PORT takes precedence over API_PORT (Render default: 10000).
# WEB_ORIGIN=https://your-project.vercel.app
# Optional additional custom web origins, comma-separated (no wildcard):
# WEB_ORIGINS=https://one.example,https://two.example
# Dockerfile.api runs bundled Cobalt automatically (no extra paid API/service).
# Native Windows development stays on yt-dlp unless explicitly configured:
# YOUTUBE_PROVIDER=cobalt
# COBALT_URL=https://your-own-cobalt.example.com
# Optional server-only key for your own authenticated remote Cobalt:
# COBALT_API_KEY=...
