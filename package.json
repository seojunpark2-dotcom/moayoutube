{
  "name": "moadrop",
  "version": "1.3.3",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "next dev --hostname 127.0.0.1",
    "dev:api": "node server/index.mjs",
    "build": "next build",
    "start": "node scripts/dev.mjs --production",
    "setup": "node scripts/sample.mjs",
    "register": "node scripts/register.mjs",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "test:browser": "node scripts/browser-check.mjs",
    "setup:youtube": "node scripts/setup-youtube.mjs",
    "start:web": "next start --hostname 0.0.0.0",
    "start:api": "node server/index.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "ipaddr.js": "^2.2.0",
    "lucide-react": "latest",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "undici": "^7.16.0"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  },
  "engines": {
    "node": "24.x"
  }
}
